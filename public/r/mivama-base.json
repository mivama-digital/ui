{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "mivama-base",
  "title": "Mivama design tokens",
  "description": "Mivama semantic design tokens for applications that install official shadcn/ui components locally.",
  "cssVars": {
    "theme": {
      "font-sans": "\"Onest Variable\", ui-sans-serif, system-ui, sans-serif",
      "font-mono": "ui-monospace, monospace",
      "radius": "0.625rem",
      "shape-control-sm": "calc(var(--radius) * 0.6)",
      "shape-control": "calc(var(--radius) * 0.8)",
      "shape-surface": "var(--radius)",
      "shape-panel": "calc(var(--radius) * 1.4)"
    },
    "light": {
      "background": "oklch(0.985 0.004 257)",
      "foreground": "oklch(0.145 0 0)",
      "card": "oklch(1 0 0)",
      "card-foreground": "oklch(0.145 0 0)",
      "popover": "oklch(1 0 0)",
      "popover-foreground": "oklch(0.145 0 0)",
      "primary": "#0c62ed",
      "primary-hover": "color-mix(in oklch, var(--primary), black 12%)",
      "primary-foreground": "#ffffff",
      "secondary": "oklch(0.97 0 0)",
      "secondary-foreground": "oklch(0.205 0 0)",
      "muted": "oklch(0.97 0 0)",
      "muted-foreground": "oklch(0.54 0 0)",
      "accent": "oklch(0.96 0.025 257)",
      "accent-foreground": "oklch(0.28 0.12 257)",
      "destructive": "oklch(0.577 0.245 27.325)",
      "destructive-foreground": "oklch(0.45 0.19 27.325)",
      "border": "oklch(0.922 0 0)",
      "border-strong": "oklch(0.82 0.008 257)",
      "input": "oklch(0.922 0 0)",
      "ring": "#0c62ed",
      "radius": "0.625rem",
      "sidebar": "oklch(0.985 0 0)",
      "sidebar-foreground": "oklch(0.145 0 0)",
      "sidebar-primary": "#0c62ed",
      "sidebar-primary-foreground": "#ffffff",
      "sidebar-accent": "oklch(0.97 0 0)",
      "sidebar-accent-foreground": "oklch(0.205 0 0)",
      "sidebar-border": "oklch(0.922 0 0)",
      "sidebar-ring": "#0c62ed",
      "chart-1": "oklch(0.87 0 0)",
      "chart-2": "oklch(0.556 0 0)",
      "chart-3": "oklch(0.439 0 0)",
      "chart-4": "oklch(0.371 0 0)",
      "chart-5": "oklch(0.269 0 0)",
      "surface": "oklch(0.97 0.006 257)",
      "surface-elevated": "oklch(1 0 0)",
      "brand": "var(--primary)",
      "brand-foreground": "var(--primary-foreground)",
      "shape-control": "calc(var(--radius) * 0.8)",
      "shape-control-sm": "calc(var(--radius) * 0.6)",
      "shape-surface": "var(--radius)",
      "shape-panel": "calc(var(--radius) * 1.4)",
      "panel-padding": "24px"
    },
    "dark": {
      "background": "oklch(0.145 0 0)",
      "foreground": "oklch(0.985 0 0)",
      "card": "oklch(0.205 0.006 257)",
      "card-foreground": "oklch(0.985 0 0)",
      "popover": "oklch(0.205 0.006 257)",
      "popover-foreground": "oklch(0.985 0 0)",
      "primary": "#78a9ff",
      "primary-hover": "color-mix(in oklch, var(--primary), white 12%)",
      "primary-foreground": "#071225",
      "secondary": "oklch(0.269 0 0)",
      "secondary-foreground": "oklch(0.985 0 0)",
      "muted": "oklch(0.269 0 0)",
      "muted-foreground": "oklch(0.708 0 0)",
      "accent": "oklch(0.27 0.045 257)",
      "accent-foreground": "oklch(0.985 0 0)",
      "destructive": "oklch(0.704 0.191 22.216)",
      "destructive-foreground": "oklch(0.88 0.08 22.216)",
      "border": "oklch(1 0 0 / 16%)",
      "border-strong": "oklch(1 0 0 / 28%)",
      "input": "oklch(1 0 0 / 20%)",
      "ring": "#4f8fff",
      "radius": "0.625rem",
      "sidebar": "oklch(0.205 0 0)",
      "sidebar-foreground": "oklch(0.985 0 0)",
      "sidebar-primary": "#78a9ff",
      "sidebar-primary-foreground": "#071225",
      "sidebar-accent": "oklch(0.269 0 0)",
      "sidebar-accent-foreground": "oklch(0.985 0 0)",
      "sidebar-border": "oklch(1 0 0 / 16%)",
      "sidebar-ring": "#4f8fff",
      "chart-1": "oklch(0.87 0 0)",
      "chart-2": "oklch(0.556 0 0)",
      "chart-3": "oklch(0.439 0 0)",
      "chart-4": "oklch(0.371 0 0)",
      "chart-5": "oklch(0.269 0 0)",
      "surface": "oklch(0.18 0.006 257)",
      "surface-elevated": "oklch(0.205 0.006 257)",
      "brand": "var(--primary)",
      "brand-foreground": "var(--primary-foreground)",
      "shape-control": "calc(var(--radius) * 0.8)",
      "shape-control-sm": "calc(var(--radius) * 0.6)",
      "shape-surface": "var(--radius)",
      "shape-panel": "calc(var(--radius) * 1.4)",
      "panel-padding": "24px"
    }
  },
  "css": {
    "@layer base": {
      "*": {
        "border-color": "var(--border)"
      },
      "body": {
        "background-color": "var(--background)",
        "color": "var(--foreground)"
      }
    }
  },
  "docs": "Install this base first. Install every UI component from the official shadcn registry; do not import @mivama/ui. Pin the registry URL to an immutable Mivama registry commit SHA.",
  "type": "registry:base"
}