    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.10",
    "@playwright/test": "^1.62.0",
