  "scripts": {
    "build": "tsup & npm run build:css & wait",
    "sync:imports": "node scripts/fix-shadcn-imports.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:runtime && npm run test:contracts",
    "audit:source": "node scripts/audit-source.mjs",
    "bundle:check": "node scripts/check-bundle-budgets.mjs",
    "pack:check": "node scripts/check-packed-package.mjs",
    "verify:core": "npm run format:check && npm run audit:source && npm run registry:check && npm run storybook:check && npm run typecheck && npm run build && npm run bundle:check && npm run test:contracts && npm run pack:check && npm run package:lint",
    "verify": "npm run lint && npm run verify:core && npm run api:check && npm run test:coverage",
    "prepublishOnly": "npm run verify",
    "prepare": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:runtime": "vitest run",
    "test:runtime:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:check": "node scripts/check-storybook-coverage.mjs",
    "storybook:typecheck": "tsc -p tsconfig.storybook.json",
    "storybook:build": "storybook build",
    "package:publint": "publint",
    "package:types": "attw --pack . --profile node16 --exclude-entrypoints styles.css reset.css tokens.css themes.css --ignore-rules cjs-resolves-to-esm false-esm",
    "package:lint": "npm run package:publint && npm run package:types",
    "registry:write": "node scripts/check-component-registry.mjs --write",
    "registry:check": "node scripts/check-component-registry.mjs",
    "api:check": "api-extractor run",
    "api:report": "api-extractor run --local",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version && node scripts/sync-package-lock-version.mjs",
    "build:js": "tsup",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify && tailwindcss -i src/reset.css -o dist/reset.css --minify && cp src/tokens.css dist/ && cp src/themes.css dist/ && cp src/tailwind.css dist/ && cp -R src/fonts dist/"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
